# Copy to .env and fill in before running a live session. All vars are read by the consumer's
# own config wiring (rlm-kit's RLMConfig.from_env() reads its own RLM_* vars separately) —
# ctx-distillery's CD_* vars are for this project's own env-driven configuration surface.

# Root/main LM identifier used for the DistillSession planner (e.g. a model name/alias).
CD_ROOT_LM=

# API key for whichever LM provider CD_ROOT_LM points at.
CD_API_KEY=

# Base URL override, if the provider isn't the default endpoint (e.g. a local proxy).
CD_BASE_URL=

# Sandbox interpreter for the RLM run. MUST stay "pyodide" — see CLAUDE.md invariant (1):
# this task never mutates or deletes anything, and pinning the sandboxed interpreter
# explicitly is part of that structural guarantee. Do not change to "local" or "container".
CD_INTERPRETER=pyodide
