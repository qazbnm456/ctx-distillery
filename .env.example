# Copy to .env and fill in before running `ctx-distillery distill`. NOTHING here is auto-loaded —
# source it yourself (`set -a; . ./.env; set +a`) or export the vars.
#
# These are read by `ctx_distillery/config.py` (`DistillConfig.from_env`), which the `distill`
# subcommand calls. Everything else is offline and needs none of it: `ctx-distillery show`,
# `ctx-distillery-apply`, `ctx-distillery-eval score`, and the studio all work on a finished
# trace file. The ONE exception is `ctx-distillery-eval run`, which DRIVES a real distillation
# per task and therefore reads this whole surface — `--stub` forces only the JUDGE offline, not
# the run it scores.
# rlm-kit's own `RLMConfig.from_env()` reads its separate `RLM_*` vars; ctx-distillery passes the
# `CD_*` values below into rlm-kit explicitly rather than sharing that surface.

# --- Models (required for a live distillation) -------------------------------------------------

# PLANNER (root LM): the orchestrator that drives the REPL loop and decides keep/prune/promote.
# REQUIRED — `distill` refuses to start without it rather than running against some default.
#
# PREFER AN INSTRUCT MODEL OVER A REASONING ONE for this seat. The planner's job is orchestration —
# call a tool, read the result, decide the next step — and an instruct model is both better at the
# format discipline that needs and cheaper per turn. A reasoning model is actively worse here for a
# structural reason, not a stylistic one: dspy reads `content` and DISCARDS `reasoning_content`, so
# the chain-of-thought is billed against CD_PLANNER_MAX_TOKENS while never appearing in the answer.
# Two failure modes follow — the reasoning exhausts the cap (empty `content`) or the answer is cut
# mid-JSON — and both are TERMINAL, because a run takes exactly one attempt (max_retries=1, so the
# iteration budget is never silently multiplied). A sibling project died on its first live turn this
# way: `AdapterParseError: Expected [reasoning, code], actual [code]`.
CD_ROOT_LM=

# Sub LM (rlm-kit's `llm_query` escalation). Defaults to CD_ROOT_LM; set it only to split the roles.
# CD_SUB_LM=

# API key and endpoint for whichever provider the models above point at.
CD_API_KEY=
# CD_BASE_URL=https://your-endpoint/v1     # OpenAI-compatible proxy (then use the plain ids it serves)

# --- OR: run planner + sub LM on a Claude Pro/Max SUBSCRIPTION (no API key) ---
# Give a role the `claude-agent-sdk/<id>` prefix and it runs on your personal Claude subscription via
# the official Claude Agent SDK (rlm-kit's `rlm_kit.ClaudeAgentLM`, the `[subscription]` extra) — each
# call a pure completion (no tools, no filesystem, no settings leakage). Prerequisites: `uv sync
# --extra subscription`; the Claude Code CLI installed and logged in (`claude` → /login, or `claude
# setup-token` → export CLAUDE_CODE_OAUTH_TOKEN); and you MUST `unset ANTHROPIC_API_KEY` — the CLI
# silently prefers it and would bill API credit (the adapter refuses to start while it is set). Prefer
# full model ids over aliases (which drift over time).
#   CD_ROOT_LM=claude-agent-sdk/claude-sonnet-5     # planner on Sonnet 5
#   CD_SUB_LM=claude-agent-sdk/claude-fable-5       # sub LM on Fable 5
# CD_API_KEY/CD_BASE_URL are then unused BY THESE TWO ROLES, but the DRAFTER still needs its own
# OpenAI-compatible endpoint — a subscription-only end-to-end run is NOT supported. You MUST set
# CD_DRAFT_LM to a real model id (and CD_DRAFT_BASE_URL/CD_DRAFT_API_KEY if it's a separate box);
# leaving it UNSET makes the drafter inherit the `claude-agent-sdk/…` CD_SUB_LM (or CD_ROOT_LM) and
# from_env fails LOUD (the drafter uses an OpenAI client, not the Agent SDK). Budgets use the SAME env
# vars as proxy mode. Expect ~2-5s CLI-spawn overhead per call, so keep runs interactive (not batch).

# DRAFTER: the model behind `draft_memory_file` / `draft_skill_file` — it authors a promotion
# candidate's markdown+frontmatter, which is then validated deterministically host-side. Defaults to
# CD_SUB_LM (so, by default, to CD_ROOT_LM). Its endpoint may differ from the planner's — and it may
# NEVER carry the `claude-agent-sdk/` sentinel, whether set explicitly or inherited (see above).
# CD_DRAFT_LM=
# CD_DRAFT_API_KEY=
# CD_DRAFT_BASE_URL=

# --- Sandbox ------------------------------------------------------------------------------------

# MUST stay "pyodide" — see CLAUDE.md invariant 1: this task never mutates or deletes anything, and
# the pin is what makes that structural. It is enforced in CODE (`task._forced_config`), so setting
# anything else here would not weaken the sandbox; `distill` REFUSES it anyway, loudly, so that a
# misconfiguration is seen rather than silently corrected. A live run needs the sandbox present:
# `brew install deno`.
CD_INTERPRETER=pyodide

# --- Budget (optional) ---------------------------------------------------------------------------

# CD_MAX_ITERATIONS=30    # hard ceiling on the single RLM episode (never multiplied by a retry)
# Planner PER-CALL generation cap. Defaults to 16384. Raise it if the planner returns empty or
# truncated turns — that is the symptom of the cap, not of a bad prompt (see CD_ROOT_LM above).
# CD_PLANNER_MAX_TOKENS=16384

# Structured-output adapter: json (default) | chat | default.
#   json    — schema-GUIDED decoding. The decoder enforces the shape, so even a model that formats
#             imperfectly still yields a valid plan. Works on OpenAI-proper and vLLM/NIM alike.
#   chat    — sends NO response_format at all; the model must follow text field-markers by
#             discipline. A dropped field has no recovery. Only for an endpoint with no
#             structured-output support.
#   default — dspy's stock adapter; its json_object fallback is rejected by vLLM/NIM.
# CD_ADAPTER=json

# Per-REPL-OUTPUT truncation cap. rlm-kit defaults to 10000 and dspy head+tail-truncates EVERY REPL
# output before it reaches the planner's prompt — and this project's transcripts arrive as a REPL
# variable, so a bare `print(transcripts[0])` on a long session silently loses the middle. Measured
# over 25 real Claude Code transcripts: median 2,739 chars, max 32,920 (2 already past rlm-kit's
# default), so the default here is raised to 40000. dspy leaves a visible "(N characters omitted)"
# marker, and `read_transcript_chunk` is the deliberate paging escape hatch for anything larger.
# CD_MAX_OUTPUT_CHARS=40000


# CD_MAX_LLM_CALLS=10     # caps sub-LM (llm_query) escalations only

# --- Where traces go (optional) -------------------------------------------------------------------

# `ctx-distillery distill` records `<dir>/<run-id>.jsonl` here, and `ctx-distillery-studio` reads the
# SAME variable for the runs it offers to replay — one directory, so a finished run shows up in the
# studio without configuring two places that have to agree. Default: ./traces
# CTXD_TRACES_DIR=./traces

# --- The eval judge (optional; used by BOTH `ctx-distillery-eval score` and `run`) ---------------------------------------

# A SEPARATE surface from CD_* on purpose: the external judge must be pointable at a different model,
# endpoint and key from the run it is scoring (`eval/ctx_distillery_eval/judge.py:EvalJudgeConfig`,
# prefix following the sibling projects' TSEVAL_/CREVAL_/DSEVAL_). The judge is LIVE iff CDEVAL_MODEL
# is set and `--stub` was not passed; with it empty, the deterministic offline StubJudge runs instead
# — zero credentials, zero network, and the whole of CI. Needs the eval member's own extra when actually
# going live — `uv sync --package ctx-distillery-eval --extra judge` (a bare `uv sync --extra judge`
# errors: `judge` belongs to ctx-distillery-eval, not the root): the import is lazy, inside the chat closure.
# CDEVAL_MODEL=            # judge model id; empty = use the offline stub judge
# CDEVAL_BASE_URL=         # any OpenAI-compatible base URL (empty = the openai default)
# CDEVAL_API_KEY=          # API key for that endpoint
# CDEVAL_TIMEOUT=60        # per-call HARD timeout in seconds (the openai client's own retries are
#                          # OFF — make_model_tool's retry loop owns retries, so the timeout stays hard)
